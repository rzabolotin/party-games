# Оболочка и service worker — всегда перепроверять на сервере
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache

# Хэшированные ассеты — кэшировать навсегда
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
